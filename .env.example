# ── Content / embeds ────────────────────────────────────────────────────────
NEXT_PUBLIC_VSL_URL=https://vimeo.com/1217229742
NEXT_PUBLIC_VSL_POSTER=
NEXT_PUBLIC_CALENDAR_EMBED_URL=https://calendly.com/hardikdhawal_1-2-1callwithhardik/diagnosis-call
NEXT_PUBLIC_COUNTDOWN_HOURS=5

# ── Site ────────────────────────────────────────────────────────────────────
# Production origin. Drives the canonical checkout URL, the origin-only
# event_source_url sent to Meta, and the host gate on every browser tracker.
NEXT_PUBLIC_SITE_URL=https://vsl.alphawellnessproject.com

# The assessment fee in rupees. Set to 1 to run a live ₹1 payment test: the
# server then treats the order as test mode and fires NOTHING to Meta or
# Pabbly. Anything above 1 is treated as a real sale.
NEXT_PUBLIC_ASSESSMENT_FEE=97

# ── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Generated in Razorpay Dashboard → Settings → Webhooks. Must match exactly or
# every webhook is rejected with invalid_signature and no lead is ever recorded.
RAZORPAY_WEBHOOK_SECRET=

# ── CRM ─────────────────────────────────────────────────────────────────────
PABBLY_WEBHOOK_URL=

# ── Meta ────────────────────────────────────────────────────────────────────
# Server-only. NEVER give the access token a NEXT_PUBLIC_ prefix — that would
# ship a token with full event-write access on the dataset to every visitor.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# The pixel id is not a secret (it is visible in the client bundle regardless).
NEXT_PUBLIC_META_PIXEL_ID=

# ── Analytics ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
